{
  "name": "del-discord",
  "version": "1.0.0",
  "private": true,
  "description": "Personal local Discord deletion and DM history userscript",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "verify": "npm run lint && npm run build && npm run check && npm test",
    "lint": "eslint src scripts tests eslint.config.js --max-warnings=0",
    "profile:memory": "node --expose-gc scripts/profile-memory.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "license": "MIT",
  "author": "Del-Discord contributors",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhomander/del-discord.git"
  }
}
